---
source: crates/graft-mcp/src/tools.rs
expression: "serde_json::to_string_pretty(&all).unwrap()"
---
[
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "readOnlyHint": false,
      "title": "Register Root"
    },
    "description": "Register the repository this server runs in as a Root, so the other tools can use it. Safe to repeat. Returns JSON {root, path, registered}; registered is false when it already was a Root.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "name": "graft_init"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false,
      "title": "Create a graft"
    },
    "description": "Create a graft: a private copy-on-write workspace checked out from Root. Returns JSON {name, path, base, backend, layers: [{path, status: built|reused, key}]}. Layers declared in Root's graft.toml (e.g. node_modules) are built on the first create and shared after; if a build fails, nothing is created and the error (code layer_build_failed) shows the build's output.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "description": "Filesystem backend: reflink (a real working tree; the default unless config.toml or $GRAFT_FS says otherwise), or a virtual graft served by graftd: fuse on Linux, nfs on macOS. Only virtual grafts support graft_bud, graft_ring and graft_rewind.",
          "enum": [
            "reflink",
            "fuse",
            "nfs"
          ],
          "type": "string"
        },
        "blueprint": {
          "description": "Blueprint of graft.toml to provision: ports, services, env files.",
          "type": "string"
        },
        "clone_ignored": {
          "description": "Git-ignored directories to reflink from Root's working tree as they are, with no build, e.g. [\"target\", \"web/node_modules\"]. Reflink grafts only.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "from": {
          "description": "Revision to start from (default: Root's HEAD).",
          "type": "string"
        },
        "name": {
          "description": "Graft name: lowercase letters, digits and hyphens, at most 40 characters.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "name": "graft_new"
  },
  {
    "annotations": {
      "readOnlyHint": true,
      "title": "List grafts"
    },
    "description": "List grafts as JSON {root, version, grafts: [...]}: each graft's name, base, state, backend, path, changed (file count) and disk_bytes. disk_bytes (blocks not shared with Root or the layer cache, so build outputs count) is measured only with disk: true, which walks every file and can take seconds for a large build tree; otherwise, or when unknown, it is null with the reason in note.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "disk": {
          "description": "Measure disk_bytes (slow for large build trees such as target/).",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "name": "graft_list"
  },
  {
    "annotations": {
      "readOnlyHint": true,
      "title": "Locate a graft"
    },
    "description": "The absolute path of a graft's working tree, as JSON {name, path}. Run shell commands there (it may contain spaces, so quote it).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Graft name: lowercase letters, digits and hyphens, at most 40 characters.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "name": "graft_path"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "readOnlyHint": false,
      "title": "Diagnose Graft"
    },
    "description": "Check whether this machine can run grafts, as JSON {version, healthy, platform, repository, repository_filesystem, reflink, graft_home, config, fuse, nfs_client, sandbox, ...}: call it first when a tool fails in a way its error does not explain (a backend that will not mount, copies instead of reflinks, a sandbox that will not start). healthy is false only when Graft cannot work at all, and then the call is a tool error with the same JSON. With report: true it also writes a diagnostics bundle for a bug report (doctor's findings, Roots and their integrity, graftd's status and recent log lines, crash files; secret-looking values redacted) under Graft's home and returns its path as report: give that path to the user, do not paste its contents, since it names paths on their machine.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "report": {
          "description": "Also write a diagnostics bundle and return its path.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "name": "graft_doctor"
  },
  {
    "annotations": {
      "readOnlyHint": true,
      "title": "Check Root's stored state"
    },
    "description": "Check this Root's stored state without changing anything: the database, that each virtual graft's op log replays to its delta exactly, that referenced blobs exist and match their hashes, that layers and reflink working trees exist, and that mounts/ holds nothing stray. Returns JSON {root, ok, checked, findings: [{severity: error|warning, check, graft, message, hint}]}; any error makes it a tool error with code fsck_failed and the same JSON in output. Call it when a graft's files, status or diff look wrong; before pruning or integrating a graft it flags, tell the user.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "quick": {
          "description": "Check that blobs exist without re-hashing them (faster on large deltas).",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "name": "graft_fsck"
  },
  {
    "annotations": {
      "readOnlyHint": true,
      "title": "Show graftd's counters"
    },
    "description": "What graftd has served since it started, as JSON {running, version, pid, uptime_ms, mounts, rss_bytes, ops: [{op, count, errors, mean_us, p50_us, p99_us, max_us}], cache_hits, cache_misses}. Covers virtual grafts (fuse, nfs) only; {running: false} when graftd is not running. Call it when file access in a virtual graft seems slow, to tell which operation is. p50_us and p99_us are power-of-two bucket bounds; errors include expected ones, such as lookups of missing names.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {},
      "type": "object"
    },
    "name": "graft_stats"
  },
  {
    "annotations": {
      "readOnlyHint": true,
      "title": "Show a graft's changes"
    },
    "description": "Show what changed in a graft since its base, as JSON {root, version, grafts: [...]}, each with its changes ({kind: A|M|D|..., path}). Without name, every graft.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Graft name: lowercase letters, digits and hyphens, at most 40 characters.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "graft_status"
  },
  {
    "annotations": {
      "readOnlyHint": true,
      "title": "Diff a graft"
    },
    "description": "Show a graft's changes as a unified diff.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Graft name: lowercase letters, digits and hyphens, at most 40 characters.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "name": "graft_diff"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false,
      "title": "Run a command in a graft"
    },
    "description": "Run a command confined to a graft: it can only write inside the graft (and its private TMPDIR), with the graft's blueprint environment. The command is an argument list, not a shell line; in [\"sh\", \"-c\", ...] a pipeline's status is its last command's, so use set -o pipefail. Returns JSON {exit_code, signal, stdout, stderr, duration_ms, timed_out, sandbox}; a non-zero exit, a signal or a timeout is a tool error with code command_failed or timed_out and the same fields. On a failure, sandbox is {denied, hint}: denied lists the paths outside the graft the sandbox refused writes to (macOS), so a failure the sandbox caused is not mistaken for a bug; hint says how to allow them.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "command": {
          "description": "Program and arguments, e.g. [\"cargo\", \"test\"].",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "dev_caches": {
          "description": "Also make toolchain caches writable: on macOS the per-user cache and temp directories (clang module cache, xcrun) and SwiftPM's caches; on Linux ~/.cache. Shared with other runs, so off by default.",
          "type": "boolean"
        },
        "name": {
          "description": "Graft name: lowercase letters, digits and hyphens, at most 40 characters.",
          "type": "string"
        },
        "timeout_secs": {
          "description": "Kill it after this many seconds (default 600).",
          "maximum": 86400,
          "minimum": 1,
          "type": "integer"
        },
        "write": {
          "description": "Absolute paths outside the graft to make writable for this run only, e.g. a tool's cache.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "name",
        "command"
      ],
      "type": "object"
    },
    "name": "graft_run"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false,
      "title": "Fork a graft"
    },
    "description": "Fork a virtual graft (backend fuse or nfs) in constant time: a new graft with the same base and a copy of its changes. Reflink grafts are refused (backend_unsupported). Returns JSON {name, src, path, base, entries}.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "dst": {
          "description": "The new graft's name.",
          "type": "string"
        },
        "src": {
          "description": "Graft name: lowercase letters, digits and hyphens, at most 40 characters.",
          "type": "string"
        }
      },
      "required": [
        "src",
        "dst"
      ],
      "type": "object"
    },
    "name": "graft_bud"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false,
      "title": "Checkpoint a graft"
    },
    "description": "Checkpoint a virtual graft's (fuse or nfs) changes as a named ring, to restore later with graft_rewind, or list its rings. Returns JSON {graft, label, seq, entries, at}, or a list of them with list.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "description": "The ring's label (default ring-<seq>).",
          "type": "string"
        },
        "list": {
          "description": "List the graft's rings instead.",
          "type": "boolean"
        },
        "name": {
          "description": "Graft name: lowercase letters, digits and hyphens, at most 40 characters.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "name": "graft_ring"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false,
      "title": "Rewind a graft to a ring"
    },
    "description": "Restore a virtual graft's changes to a ring made with graft_ring. The state it leaves is saved first as a ring named undo-<seq>, so a rewind can itself be undone. Returns JSON {name, ring, seq, undo}.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Graft name: lowercase letters, digits and hyphens, at most 40 characters.",
          "type": "string"
        },
        "ring": {
          "description": "The ring's label, as graft_ring lists it.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "ring"
      ],
      "type": "object"
    },
    "name": "graft_rewind"
  },
  {
    "annotations": {
      "readOnlyHint": true,
      "title": "Find overlapping work"
    },
    "description": "Overlaps between live grafts, as JSON: same file (path), same symbol, merge conflicts, or tests that fail only when merged (behaviour). To be told when overlaps change, subscribe to the resource graft://radar/<graft> (or graft://radar for all).",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "check": {
          "description": "Run the behaviour checks (speculative merges with the [radar] test) first.",
          "type": "boolean"
        },
        "graft": {
          "description": "Only overlaps involving this graft.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "graft_radar"
  },
  {
    "annotations": {
      "destructiveHint": true,
      "readOnlyHint": false,
      "title": "Land grafts in Root"
    },
    "description": "Merge grafts onto a branch of Root through the integrate queue: structural merge, the [integrate] test gate if graft.toml sets one (the result says when none ran), one commit each. Changes Root's history, so it needs confirm: true unless dry_run. Returns JSON {results: [{graft, target, state, code, commit, output}], gated}; if any request did not land, it is a tool error whose code is the first failed request's (conflict, gate_failed, checkout_would_fall_behind, root_not_clean, not_approved, nothing_to_integrate, claimed, failed) and whose output holds the results.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "confirm": {
          "description": "Required (true) to land anything.",
          "type": "boolean"
        },
        "create_branch": {
          "description": "Create onto at Root's HEAD if it does not exist (else a missing branch is an error).",
          "type": "boolean"
        },
        "dry_run": {
          "description": "Run every step and check except landing, including the checked-out-branch rule, so a passing dry run predicts the real one.",
          "type": "boolean"
        },
        "message": {
          "description": "Commit message.",
          "type": "string"
        },
        "names": {
          "description": "Grafts, in order.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "onto": {
          "description": "Branch to land on (default: [integrate] branch in graft.toml, else the branch Root has checked out, which also needs update_checkout).",
          "type": "string"
        },
        "prune": {
          "description": "Prune each graft once it has landed.",
          "type": "boolean"
        },
        "test": {
          "description": "Shell command to use as this call's test gate instead of graft.toml's [integrate] test, e.g. \"cargo test\". Runs confined to the scratch checkout; needs no graft trust.",
          "type": "string"
        },
        "update_checkout": {
          "description": "Allow landing on the branch Root has checked out: Root's working tree is fast-forwarded, which needs no changes to tracked files (untracked files are left alone).",
          "type": "boolean"
        }
      },
      "required": [
        "names"
      ],
      "type": "object"
    },
    "name": "graft_integrate"
  },
  {
    "annotations": {
      "destructiveHint": false,
      "readOnlyHint": false,
      "title": "Plan a task"
    },
    "description": "Split a task into an ordered DAG of grafts along the code's dependency graph, as JSON {plan, base, nodes, width, unresolved}. The task names files, directories (every file under them) and symbols in `code spans`; spans that name nothing yet (a new file, an unknown symbol) are listed in unresolved, not placed. With apply, creates the grafts that are ready and records their claims.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "apply": {
          "description": "Create the ready grafts.",
          "type": "boolean"
        },
        "backend": {
          "enum": [
            "reflink",
            "fuse",
            "nfs"
          ],
          "type": "string"
        },
        "task": {
          "description": "The task, as Markdown.",
          "type": "string"
        },
        "task_file": {
          "description": "Or a path to it.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "graft_plan"
  },
  {
    "annotations": {
      "destructiveHint": true,
      "readOnlyHint": false,
      "title": "Remove a graft"
    },
    "description": "Remove a graft. Refuses if work would be lost (code work_would_be_lost); force discards it and needs confirm: true. Its working tree is moved aside at once and deleted in the background, so the name is free again immediately. Returns JSON {name, pruned}.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "confirm": {
          "description": "Required (true) with force.",
          "type": "boolean"
        },
        "force": {
          "description": "Discard uncommitted or unintegrated work.",
          "type": "boolean"
        },
        "name": {
          "description": "Graft name: lowercase letters, digits and hyphens, at most 40 characters.",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "name": "graft_prune"
  }
]
